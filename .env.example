# ==============================================================================
# Variables de Entorno - Subsistema de Inteligencia Artificial Local (On-Premise)
# Sistema Voice AI - Centro de Salud Mental y Terapia Especializada
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Servicio de Transcripción (whisper-service)
# ------------------------------------------------------------------------------
# Modelo Whisper a utilizar:
# Opciones recomendadas:
#   - large-v3-turbo (Alta fidelidad fonética en español, balance óptimo de VRAM)
#   - distil-large-v3 (Menor latencia con precisión similar)
#   - small (Bajo consumo de memoria para despliegues restringidos en CPU)
WHISPER_MODEL=large-v3-turbo

# Aceleración de hardware (cuda | cpu)
WHISPER_DEVICE=cuda

# Tipo de cómputo / cuantización:
#   - float16 (Óptimo para GPU NVIDIA con Tensor Cores)
#   - int8 (Óptimo para mitigación y procesamiento en CPU)
WHISPER_COMPUTE_TYPE=float16

# Conmutador de tolerancia a fallos: Si CUDA falla o no hay GPU, conmuta automáticamente a CPU
WHISPER_CPU_FALLBACK=true

# Directorio de montaje en memoria RAM volátil (tmpfs) - Ley N° 21.719
AUDIO_RAM_DIR=/tmp/audio_ram

# Límite máximo de tamaño de archivo de audio en MB (prevención de agotamiento de RAM)
MAX_AUDIO_SIZE_MB=50

# Puerto de escucha del microservicio Whisper
WHISPER_PORT=8000


# ------------------------------------------------------------------------------
# 2. Configuración del Servicio de LLM Clínico (ollama-service)
# ------------------------------------------------------------------------------
# Modelo de lenguaje base para estructuración clínica:
# Opciones soportadas:
#   - llama3.1:8b-instruct-q4_K_M (Cuantización recomendada para precisión y memoria)
#   - llama3.3 (Mayor capacidad analítica)
#   - qwen2.5:7b (Excelente estructuración JSON determinista)
#   - qwen2.5-coder:7b
LLM_MODEL=llama3.1:8b-instruct-q4_K_M

# Persistencia del modelo cargado en memoria RAM/VRAM (evita recarga entre atenciones)
OLLAMA_KEEP_ALIVE=24h

# Número de atenciones procesables en paralelo
OLLAMA_NUM_PARALLEL=2

# Cantidad de capas delegadas a GPU (99 = 100% VRAM, 0 = 100% CPU)
OLLAMA_NUM_GPU=99

# Puerto de escucha del microservicio Ollama
OLLAMA_PORT=11434
OLLAMA_URL=http://ollama-service:11434


# ------------------------------------------------------------------------------
# 3. Microservicio RAG Context & Ingesta Documental (rag-service)
# ------------------------------------------------------------------------------
# Puerto interno del servicio RAG
RAG_PORT=8090
RAG_URL=http://rag-service:8090
RAG_DATA_DIR=/app/data

# Modelo para embeddings semánticos (utiliza el modelo local de Ollama)
EMBED_MODEL=llama3.1:8b-instruct-q4_K_M


# ------------------------------------------------------------------------------
# 4. Portabilidad de Hardware (CPU vs GPU vs RAM)
# ------------------------------------------------------------------------------
# Perfil de ejecución de hardware:
#   - gpu: Activa passthrough de GPU NVIDIA con CUDA (float16 / VRAM)
#   - cpu: Conmuta toda la inferencia a CPU con cuantización int8
#
# Para despliegues en servidores o laptops sin GPU NVIDIA:
# 1. Ajustar:
#    WHISPER_DEVICE=cpu
#    WHISPER_COMPUTE_TYPE=int8
#    OLLAMA_NUM_GPU=0
# 2. Utilizar el archivo de despliegue CPU:
#    docker compose -f docker-compose.yml -f docker-compose.cpu.yml up -d
HARDWARE_PROFILE=gpu


# ------------------------------------------------------------------------------
# 5. Parámetros de Bastionado y CIS Benchmark
# ------------------------------------------------------------------------------
# Identificadores de usuario y grupo no privilegiados
PUID=10001
PGID=10001

# Tamaños de los montajes temporales en memoria RAM (tmpfs)
TMPFS_AUDIO_SIZE=512M
TMPFS_TMP_SIZE=1G

# Dispositivos GPU visibles para los contenedores (usar 'all' o ID de tarjeta '0')
NVIDIA_VISIBLE_DEVICES=all
