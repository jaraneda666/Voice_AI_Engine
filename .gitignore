# ==============================================================================
# .gitignore - Voice_AI_Engine
# Seguridad y Privacidad: Exclusión estricta de secretos, caches y datos clínicos
# ==============================================================================

# Variables de entorno y secretos locales
.env
*.env.local

# Certificados SSL y claves privadas (nunca commitear claves a Git - TKAI-001)
nginx/certs/*.crt
nginx/certs/*.key
nginx/certs/*.pem
nginx/certs/*.csr
!nginx/certs/.gitkeep
!nginx/certs/README.md
!nginx/certs/generate_certs.py
!nginx/certs/generate_certs.sh

# Caches y bytecode de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Almacenamiento local del motor RAG (datos y documentos Markdown)
rag-service/data/*
!rag-service/data/.gitkeep

# Archivos temporales y de depuración
*.log
*.tmp
temp/
scratch/
test_protocolo_adicciones.txt
protocolo_craving_clinico.txt

# Archivos de sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Respaldos y Backups locales (Regla Global Antigravity)
backups/
backup/
respaldos/
backup_*/
*_backup*
*.bak*

# Auditorías y Vulnerabilidades (Exclusión estricta de GitHub)
*informe*
*reporte*
*finding*
*hallazgo*
*vulnerab*
*evidencia*
*poc*
output/
